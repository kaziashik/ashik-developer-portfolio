# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas — replace with your real connection string later
DATABASE_URL="your_connection_string_here"

# Auth
BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_SECRET=''
JWT_REFRESH_SECRET='refreToken'
JWT_ACCESS_EXPIRES_IN='1d'
JWT_REFRESH_EXPIRES_IN='7d'

# Used once by `npm run seed:admin` to create your one admin account.
# Not read anywhere else — safe to leave blank after seeding, or remove.
ADMIN_NAME="Kazi Ashikur Rahman"
ADMIN_EMAIL="kazia096@gmail.com"
ADMIN_PASSWORD="change_this_before_seeding"

# Comma-separated list of frontend origins allowed to call this API
CLIENT_URLS="http://localhost:5173,http://localhost:3000,https://ashikportfolio-auth.web.app"
