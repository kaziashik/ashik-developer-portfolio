# =============================================================================
# Shared secrets — copy this file to `.env` and fill in your values.
# `.env` is gitignored. Do NOT commit it.
# =============================================================================

# Firebase (Firebase Console → Project Settings → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudinary (admin profile image upload)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# =============================================================================
# API URL is NOT set here — it switches automatically:
#
#   npm run dev     → .env.development  → http://localhost:5000
#   npm run build   → .env.production   → your Vercel backend URL
#
# Edit `.env.development` or `.env.production` if you need different URLs.
# =============================================================================
